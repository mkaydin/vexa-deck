# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local sessions, generated music, reports, logs and application preferences
/var/
/runtime/
/output/
/runs/
/assets/generated/
/assets/library/
/assets/audio/
/data/sessions/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log

# User-uploaded videos (created by the installer; never distributed)
/vexa-videos/

# Model downloads, checkpoints and tensor caches; weights have separate terms
/models/
/weights/
/checkpoints/
*.safetensors
*.gguf
*.ggml
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.hdf5
*.bin
*.npy
*.npz
*.partial
*.part

# Release archives, native builds and package staging
/dist/
/build/
*.AppImage
*.deb
*.rpm
*.whl
*.tar.gz
*.tar.xz
*.zip
.vexa-install.json

# Local third-party inference source/builds; retain video renderer attribution
/third_party/*
!/third_party/video-art/

# Credentials and machine-local settings
.env
.env.*
!.env.example
/.aws/
/.codex/
/.agents/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

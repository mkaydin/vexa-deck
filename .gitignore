var/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
runtime/

# Docker

# Fine-tuning runs and checkpoints. Weights are separate artifacts under their own licence
# (YuE2 CC BY-NC 4.0), so they must never be committed.
runs/
*.safetensors
*.gguf

# Audio + model artifacts. Source, weights, audio and datasets stay separate
# downloads governed by their own terms. See ROADMAP.md "Risks to test early".
assets/generated/
assets/library/
assets/audio/
models/
weights/
data/sessions/

# Keys
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Vendored third-party builds. yue2.cpp is cloned and compiled locally and carries 4.3 GB

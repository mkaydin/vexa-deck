# Copy to .env and edit. Every value here is optional: the stack boots and works with none of them.

# --- ports on the host -------------------------------------------------------
VEXA_ORCHESTRATOR_PORT=8080
VEXA_PLANNER_PORT=8081
VEXA_LOG_LEVEL=info
# Host live sets require full-length tracks; short legacy renders remain in the depot.
VEXA_MIN_TRACK_DURATION_S=148
# Desktop launcher, backend, and GUI write timestamped logs here.
VEXA_LOG_DIR=var/logs

# --- the LLM planner ---------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint.
#
#   hosted   https://api.openai.com/v1
#   local    http://localhost:11434/v1        (ollama)
#            http://localhost:8000/v1         (vLLM)
#            http://localhost:1234/v1         (LM Studio)
#
# Leave these blank and the local rule-based planner carries the set. That is a supported
# configuration, not a degraded one: basic playback never requires a remote service.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=

# --- model services (run on the HOST, not in compose) ------------------------
# These are read by tools/ and the host-side workers, not by any container.
#
# Laya inference device is selected by NAME. nvidia-smi and torch enumerate these two cards in
# opposite order, so an index-based config silently picks the wrong one (PLAN.md §3.1).
VEXA_LAYA_DEVICE=RTX 5060 Ti
VEXA_LAYA_CHECKPOINT=convaiinnovations/laya-typed-decisions

# YuE2 generation backend: yue2.cpp | torch | audio.cpp
# The host runner chooses the RTX 5060 Ti by UUID as its primary GPU. CUDA and nvidia-smi
# index orders differ on this host. VEXA_YUE_GPU accepts a GPU UUID or nvidia-smi index.
VEXA_YUE2_BACKEND=yue2.cpp
VEXA_YUE_GPU=

# Default: local ACE-Step music-specific text planner (lyrics + production attributes).
# Install: uv sync --extra core --extra local-planner
# Then: .venv/bin/python tools/install_music_planner.py
# And: .venv/bin/python tools/install_local_lyric_writer.py
VEXA_MUSIC_PLANNER=acestep
# Optional override; default models/acestep-5Hz-lm-1.7B inside the checkout.
VEXA_ACE_MODEL=
# Coherent original lyrics are written by the existing local Ollama Gemma.
# The writer is unloaded before ACE-Step loads; both are unloaded before YuE2.
VEXA_ACE_WRITER_MODEL=gemma4:e4b
# Empty: private Ollama worker restricted to RTX 5060 Ti.
VEXA_ACE_WRITER_URL=
VEXA_ACE_MAX_TOKENS=1024
VEXA_ACE_TIMEOUT_S=1800

# Optional remote alternative: set VEXA_MUSIC_PLANNER=ollama.
# Uses Ollama nemotron-3-super:cloud for the ten-track YuE2 batch.
# The local Ollama server must be signed in for cloud model access.
# Set both URL and model for another OpenAI-compatible endpoint.
# Set VEXA_LLM_PROVIDER=none to use ten distinct local production briefs.
VEXA_LLM_PROVIDER=ollama
VEXA_LLM_BASE_URL=http://127.0.0.1:11434
VEXA_LLM_MODEL=nemotron-3-super:cloud
VEXA_LLM_API_KEY=

# Radio playback buffer: 2048 frames (~46 ms at 44.1 kHz).
VEXA_AUDIO_BLOCKSIZE=2048

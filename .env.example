# Copy to .env and edit. Every value here is optional: the stack boots and works with none of them.

# --- ports on the host -------------------------------------------------------
VEXA_ORCHESTRATOR_PORT=8080
VEXA_PLANNER_PORT=8081
VEXA_LOG_LEVEL=info

# --- the LLM planner ---------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint.
#
#   hosted   https://api.openai.com/v1
#   local    http://localhost:11434/v1        (ollama)
#            http://localhost:8000/v1         (vLLM)
#            http://localhost:1234/v1         (LM Studio)
#
# Leave these blank and the local rule-based planner carries the set. That is a supported
# configuration, not a degraded one: basic playback never requires a remote service.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=

# --- model services (run on the HOST, not in compose) ------------------------
# These are read by tools/ and the host-side workers, not by any container.
#
# Laya inference device is selected by NAME. nvidia-smi and torch enumerate these two cards in
# opposite order, so an index-based config silently picks the wrong one (PLAN.md §3.1).
VEXA_LAYA_DEVICE=RTX 5060 Ti
VEXA_LAYA_CHECKPOINT=convaiinnovations/laya-typed-decisions

# YuE2 generation backend: yue2.cpp | torch | audio.cpp
# yue2.cpp Q8_0 fits an 8 GB card; torch BF16 needs ~11.2 GiB and so only runs on the 16 GB one.
VEXA_YUE2_BACKEND=yue2.cpp
VEXA_YUE2_GPU=RTX 4060